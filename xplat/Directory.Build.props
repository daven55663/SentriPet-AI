<Project>
  <!-- Shared by the .NET 10 projects. Nullable and implicit usings stay off (the core was written without them). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SentriPet</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- SYSLIB0014: WebRequest (the HTTP plugin code still uses it) -->
    <NoWarn>$(NoWarn);SYSLIB0014;CS0618</NoWarn>
    <Version>2.5.0</Version>
    <Authors>歐育典</Authors>
    <Copyright>Copyright © 2026 歐育典 · MIT License</Copyright>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
</Project>
