<Project Sdk="Microsoft.NET.Sdk">
  <!-- The platform-neutral core: the same source files the Windows build compiles (src/Core, src/Providers). -->
  <PropertyGroup>
    <AssemblyName>SentriPet.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\Core\**\*.cs" LinkBase="Core" />
    <Compile Include="..\..\src\Providers\**\*.cs" LinkBase="Providers" />
    <!-- translations: src/Lang/xx.json is read as the resource SentriPet.Lang.xx.json -->
    <EmbeddedResource Include="..\..\src\Lang\*.json" LinkBase="Lang" LogicalName="SentriPet.Lang.%(Filename).json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SentriPet.Tests" />
    <InternalsVisibleTo Include="SentriPet" />
  </ItemGroup>
</Project>
