{
  "id": "file-demo",
  "name": "檔案範例",
  "color": "#34D399",
  "mascot": "llama",
  "detect": { "paths": ["~/my-ai-usage.json"] },
  "source": { "type": "file", "path": "~/my-ai-usage.json" },
  "metersFrom": {
    "path": "$.limits",
    "used": "percent",
    "resetsAt": "reset",
    "labels": { "daily": "每日", "monthly": "每月" },
    "windowMinutes": { "daily": 1440, "monthly": 43200 }
  }
}
